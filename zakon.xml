    <lrml:Statements>
        <lrml:PrescriptiveStatement key="ps10_stav1">

            <ruleml:Rule
                key="rule_clan10_stav1"
                closure="universal">
                <ruleml:if>
                    <ruleml:And>                    
                        <ruleml:Atom>
                            <ruleml:Rel iri="http://www.semanticweb.org/lenovo/ontologies/2026/8/zastitaPotrosaca#Trgovac"/>
                            <ruleml:Var>X</ruleml:Var>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="http://www.semanticweb.org/lenovo/ontologies/2026/8/zastitaPotrosaca#UgostiteljskiObjekat"/>
                            <ruleml:Var>Y</ruleml:Var>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="http://www.semanticweb.org/lenovo/ontologies/2026/8/zastitaPotrosaca#obavljaDelatnost"/>
                            <ruleml:Var>X</ruleml:Var>
                            <ruleml:Var>Y</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>

                <ruleml:then>
                    <lrml:Obligation key="oblig10_stav1">
                        <ruleml:slot>
                            <lrml:Bearer
                                iri="http://www.semanticweb.org/lenovo/ontologies/2026/8/zastitaPotrosaca#UgostiteljskiObjekat"/>
                            <ruleml:Var>X</ruleml:Var>
                        </ruleml:slot>

                        <ruleml:Atom>
                            <ruleml:Rel
                                iri="http://www.semanticweb.org/lenovo/ontologies/2026/8/zastitaPotrosaca#jasnoIsticeCenovnik"/>
