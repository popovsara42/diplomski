                                <ruleml:Var>X</ruleml:Var>

                                <ruleml:slot>
                                    <ruleml:Ind iri="http://example.org/legal#minKazna">
                                        300000
                                    </ruleml:Ind>
                                </ruleml:slot>

                                <ruleml:slot>
                                    <ruleml:Ind iri="http://example.org/legal#maxKazna">
                                        2000000
