        <lrml:PrescriptiveStatement key="ps40_stav1">
            <ruleml:Rule key="rule_clan40_stav1" closure="universal">

                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel iri="http://example.org/legal#Isporuka"/>
                            <ruleml:Var>I</ruleml:Var>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="http://example.org/legal#jePosaljilacIsporuke"/>
                            <ruleml:Var>T</ruleml:Var>
                            <ruleml:Var>I</ruleml:Var>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="http://example.org/legal#jePrimalacIsporuke"/>
                            <ruleml:Var>P</ruleml:Var>
                            <ruleml:Var>I</ruleml:Var>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="http://example.org/legal#odnosiSeNaProizvod"/>
                            <ruleml:Var>I</ruleml:Var>
                            <ruleml:Var>Y</ruleml:Var>
                        </ruleml:Atom>

                        
                        
                                <ruleml:Atom>
                                    <ruleml:Rel iri="http://example.org/legal#Porudzbina"/>
                                    <ruleml:Var>X</ruleml:Var>
                                </ruleml:Atom> 
                                <ruleml:Atom>
                                    <ruleml:Rel iri="http://example.org/legal#jeNarucilacPorudzbine"/>
                                    <ruleml:Var>P</ruleml:Var>
                                    <ruleml:Var>X</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="http://example.org/legal#seNarucujeOd"/>
                                    <ruleml:Var>X</ruleml:Var>
                                    <ruleml:Var>T</ruleml:Var>
                                </ruleml:Atom> 
                                <ruleml:Negation>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="http://example.org/legal#odnosiSeNaProizvod"/>
                                        <ruleml:Var>X</ruleml:Var>
                                        <ruleml:Var>Y</ruleml:Var>
                                    </ruleml:Atom>
                                </ruleml:Negation>
                    </ruleml:And>
                </ruleml:if>

                <ruleml:then>
                    <lrml:Obligation key="oblig40_stav1">
                        <ruleml:Negation>
                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#zahtevaPlacanjeOd"/>
                                <ruleml:Var>T</ruleml:Var>
                                <ruleml:Var>P</ruleml:Var>
                            </ruleml:Atom>
                        </ruleml:Negation>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>

        <lrml:PrescriptiveStatement key="ps40_stav4">
                <ruleml:Rule key="rule_clan40_stav4" closure="universal">

                    <lrml:hasStrength>
                        <lrml:Defeater key="str40_stav4"/>
                    </lrml:hasStrength>

                    <ruleml:if>
                        <ruleml:And>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#Isporuka"/>
                                <ruleml:Var>I</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#jePosaljilacIsporuke"/>
                                <ruleml:Var>T</ruleml:Var>
                                <ruleml:Var>I</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#jePrimalacIsporuke"/>
                                <ruleml:Var>P</ruleml:Var>
                                <ruleml:Var>I</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#odnosiSeNaProizvod"/>
                                <ruleml:Var>I</ruleml:Var>
                                <ruleml:Var>Y</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#Porudzbina"/>
                                <ruleml:Var>X</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#jeNarucilacPorudzbine"/>
                                <ruleml:Var>P</ruleml:Var>
                                <ruleml:Var>X</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#seNarucujeOd"/>
                                <ruleml:Var>X</ruleml:Var>
                                <ruleml:Var>T</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Negation>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="http://example.org/legal#odnosiSeNaProizvod"/>
                                    <ruleml:Var>X</ruleml:Var>
                                    <ruleml:Var>Y</ruleml:Var>
                                </ruleml:Atom>
                            </ruleml:Negation>

                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#jeObavestio"/>
                                <ruleml:Var>T</ruleml:Var>
                                <ruleml:Var>P</ruleml:Var>
                            </ruleml:Atom>

                        </ruleml:And>
                    </ruleml:if>

                    <ruleml:then>
                        <lrml:Obligation key="oblig40_stav4">
                            <ruleml:Atom>
                                <ruleml:Rel iri="http://example.org/legal#zahtevaPlacanjeOd"/>
                                <ruleml:Var>T</ruleml:Var>
                                <ruleml:Var>P</ruleml:Var>
                            </ruleml:Atom>
                        </lrml:Obligation>
                    </ruleml:then>
                </ruleml:Rule>
            </lrml:PrescriptiveStatement>


            <lrml:Override
